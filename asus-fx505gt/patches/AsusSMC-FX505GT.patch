diff --git a/AsusSMC/FXProfileABI.h b/AsusSMC/FXProfileABI.h
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXProfileABI.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: MIT
+ * Fixed FX505GT firmware-profile interface. No generic ACPI/WMI/EC selectors.
+ */
+#ifndef FX_PROFILE_ABI_H
+#define FX_PROFILE_ABI_H
+#include <stdint.h>
+#define FX_PROFILE_ABI_VERSION 1u
+#define FX_PROFILE_CONNECT_TYPE 0x46583250u
+#define FX_PROFILE_UNKNOWN 0xffffffffu
+#define FX_PROFILE_SERVICE "AsusSMC"
+enum FXSelector { FXQuery = 0, FXSetProfile = 1, FXSetClamshell = 4 };
+enum FXProfile { FXNormal = 0, FXOverboost = 1, FXSilent = 2 };
+enum FXBackend { FXNoBackend = 0, FXFanBoost = 1, FXThermalPolicy = 2 };
+enum FXState {
+    FXDisabled = 0, FXModelNotDeclared = 1, FXWMIMethodUnverified = 2,
+    FXUnprobed = 3, FXUnsupported = 4, FXFirmwareError = 5,
+    FXReady = 6, FXStopped = 7, FXSuspended = 8, FXPowerNotifierUnavailable = 9
+};
+enum FXRawStatus { FXNotRead = 0, FXRawOK = 1, FXTransportError = 2, FXInvalidMethod = 3 };
+enum FXRequestStatus {
+    FXNeverRequested = 0, FXAccepted = 1, FXRejected = 2,
+    FXWriteTransportError = 3, FXWriteInvalidMethod = 4, FXWriteUnexpectedResult = 5
+};
+enum FXSource { FXNoSource = 0, FXCommandLine = 1, FXFnF5 = 2 };
+enum FXFlags {
+    FXEnabledFlag = 1u << 0, FXModelDeclaredFlag = 1u << 1,
+    FXModelVerifiedFlag = 1u << 2, /* Reserved: never asserted by v1. */
+    FXWMIVerifiedFlag = 1u << 3, FXFnF5EnabledFlag = 1u << 4
+};
+/* All fields are fixed-width; no pointers, bools, native enums or padding. */
+typedef struct FXProfileSnapshot {
+    uint32_t version, size, state, flags;
+    uint32_t backend, supportedProfiles, currentProfile, reserved0;
+    uint32_t thermalProbeStatus, thermalProbeRaw, thermalProbeIOReturn;
+    uint32_t fanProbeStatus, fanProbeRaw, fanProbeIOReturn;
+    uint32_t lastRequestedProfile, lastRequestSource, lastRequestStatus;
+    uint32_t lastWriteRawStatus, lastWriteRaw, lastWriteIOReturn;
+    uint32_t lastAcceptedProfile, lastAcceptedSource, acceptedCount;
+    uint32_t fnEventCount, fnSuppressedCount, reserved1;
+    uint32_t lastRequestUptimeLo, lastRequestUptimeHi;
+    uint32_t lastAcceptedUptimeLo, lastAcceptedUptimeHi;
+} FXProfileSnapshot;
+#ifdef __cplusplus
+static_assert(sizeof(FXProfileSnapshot) == 30 * sizeof(uint32_t), "FX ABI changed");
+#endif
+#endif
diff --git a/AsusSMC/FXProfilePolicy.hpp b/AsusSMC/FXProfilePolicy.hpp
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXProfilePolicy.hpp
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: MIT
+ * Independently written policy. Protocol facts: pinned faustus, see SOURCES.md.
+ * This file deliberately contains no IOKit, ACPI or device I/O.
+ */
+#ifndef FX_PROFILE_POLICY_HPP
+#define FX_PROFILE_POLICY_HPP
+#include "FXProfileABI.h"
+namespace fx {
+static const uint32_t ThermalDevice = 0x00120075u;
+static const uint32_t FanBoostDevice = 0x00110018u;
+static const uint32_t Presence = 0x00010000u;
+static const uint64_t DebounceNS = 250000000ull;
+struct Raw {
+    uint32_t status, value, ioReturn;
+    static Raw unread() { return {FXNotRead, 0, 0}; }
+    static Raw decode(bool ok, uint32_t value, uint32_t ioReturn) {
+        if (!ok) return {FXTransportError, 0, ioReturn};
+        if (value == 0xfffffffeu || value == 0xffffffffu)
+            return {FXInvalidMethod, value, ioReturn};
+        return {FXRawOK, value, ioReturn};
+    }
+};
+class Policy {
+    FXProfileSnapshot s_ {};
+    bool fnSeen_ {false};
+    uint64_t lastFnNS_ {0};
+public:
+    Policy() {
+        s_.version = FX_PROFILE_ABI_VERSION;
+        s_.size = sizeof(s_);
+        s_.currentProfile = FX_PROFILE_UNKNOWN;
+        s_.lastRequestedProfile = FX_PROFILE_UNKNOWN;
+        s_.lastAcceptedProfile = FX_PROFILE_UNKNOWN;
+    }
+    const FXProfileSnapshot &snapshot() const { return s_; }
+    void configure(bool enabled, bool modelDeclared, bool wmiVerified, bool fnEnabled) {
+        s_.flags = (enabled ? static_cast<uint32_t>(FXEnabledFlag) : 0u) |
+            (modelDeclared ? static_cast<uint32_t>(FXModelDeclaredFlag) : 0u) |
+            (wmiVerified ? static_cast<uint32_t>(FXWMIVerifiedFlag) : 0u) |
+            (fnEnabled ? static_cast<uint32_t>(FXFnF5EnabledFlag) : 0u);
+        s_.state = !enabled ? FXDisabled : !modelDeclared ? FXModelNotDeclared :
+            !wmiVerified ? FXWMIMethodUnverified : FXUnprobed;
+    }
+    bool mayProbe() const {
+        return s_.state == FXUnprobed || s_.state == FXUnsupported ||
+            s_.state == FXFirmwareError || s_.state == FXReady;
+    }
+    void probe(Raw thermal, Raw fan) {
+        if (!mayProbe()) return;
+        s_.thermalProbeStatus = thermal.status;
+        s_.thermalProbeRaw = thermal.value;
+        s_.thermalProbeIOReturn = thermal.ioReturn;
+        s_.fanProbeStatus = fan.status;
+        s_.fanProbeRaw = fan.value;
+        s_.fanProbeIOReturn = fan.ioReturn;
+        uint32_t oldBackend = s_.backend, oldMask = s_.supportedProfiles;
+        s_.backend = FXNoBackend;
+        s_.supportedProfiles = 0;
+        if (thermal.status == FXRawOK && (thermal.value & Presence)) {
+            s_.backend = FXThermalPolicy;
+            s_.supportedProfiles = 7u;
+        } else if (fan.status == FXRawOK && (fan.value & Presence) && (fan.value & 3u)) {
+            s_.backend = FXFanBoost;
+            s_.supportedProfiles = 1u | ((fan.value & 3u) << 1);
+        }
+        if (s_.backend != FXNoBackend) s_.state = FXReady;
+        else if (thermal.status == FXTransportError || fan.status == FXTransportError) s_.state = FXFirmwareError;
+        else s_.state = FXUnsupported;
+        if (oldBackend != s_.backend || oldMask != s_.supportedProfiles) {
+            s_.lastAcceptedProfile = FX_PROFILE_UNKNOWN;
+            s_.lastAcceptedSource = FXNoSource;
+            s_.lastAcceptedUptimeLo = s_.lastAcceptedUptimeHi = 0;
+        }
+        /* Never derive currentProfile from DSTS: low bits are capabilities. */
+    }
+    uint32_t device() const {
+        return s_.backend == FXThermalPolicy ? ThermalDevice :
+            s_.backend == FXFanBoost ? FanBoostDevice : 0u;
+    }
+    bool prepare(uint32_t profile, uint32_t source, uint64_t nowNS = 0) {
+        if (source != FXCommandLine && source != FXFnF5) return false;
+        s_.lastRequestedProfile = profile;
+        s_.lastRequestSource = source;
+        s_.lastRequestStatus = FXRejected;
+        s_.lastRequestUptimeLo = static_cast<uint32_t>(nowNS);
+        s_.lastRequestUptimeHi = static_cast<uint32_t>(nowNS >> 32);
+        s_.lastWriteRawStatus = FXNotRead;
+        s_.lastWriteRaw = s_.lastWriteIOReturn = 0;
+        if (s_.state != FXReady || profile > FXSilent ||
+            !(s_.supportedProfiles & (1u << profile))) return false;
+        s_.lastRequestStatus = FXNeverRequested;
+        return true;
+    }
+    bool complete(Raw result, uint64_t nowNS = 0) {
+        s_.lastWriteRawStatus = result.status;
+        s_.lastWriteRaw = result.value;
+        s_.lastWriteIOReturn = result.ioReturn;
+        if (result.status == FXTransportError) s_.lastRequestStatus = FXWriteTransportError;
+        else if (result.status == FXInvalidMethod) s_.lastRequestStatus = FXWriteInvalidMethod;
+        else if (result.status != FXRawOK || result.value != 1u)
+            s_.lastRequestStatus = FXWriteUnexpectedResult;
+        else {
+            s_.lastRequestStatus = FXAccepted;
+            s_.lastAcceptedProfile = s_.lastRequestedProfile;
+            s_.lastAcceptedSource = s_.lastRequestSource;
+            s_.lastAcceptedUptimeLo = static_cast<uint32_t>(nowNS);
+            s_.lastAcceptedUptimeHi = static_cast<uint32_t>(nowNS >> 32);
+            ++s_.acceptedCount;
+            return true;
+        }
+        /* A failed/ambiguous write may have changed hardware. Never treat an
+         * earlier accepted command as the current state or cycle anchor. */
+        s_.lastAcceptedProfile = FX_PROFILE_UNKNOWN;
+        s_.lastAcceptedSource = FXNoSource;
+        s_.lastAcceptedUptimeLo = s_.lastAcceptedUptimeHi = 0;
+        return false;
+    }
+    bool fnEvent(uint32_t code, uint64_t nowNS, uint32_t &requested) {
+        if (code != 0x99u && code != 0xaeu) return false;
+        ++s_.fnEventCount;
+        if (s_.state != FXReady || !(s_.flags & FXFnF5EnabledFlag)) return false;
+        if ((s_.backend == FXFanBoost && code != 0x99u) ||
+            (s_.backend == FXThermalPolicy && code != 0xaeu)) return false;
+        if (fnSeen_ && nowNS >= lastFnNS_ && nowNS - lastFnNS_ < DebounceNS) {
+            ++s_.fnSuppressedCount;
+            return false;
+        }
+        fnSeen_ = true;
+        lastFnNS_ = nowNS;
+        /* Unknown after attach/error/backend change: explicitly request normal
+         * first. Otherwise cycle the last accepted command, not a measurement. */
+        if (s_.lastAcceptedProfile == FX_PROFILE_UNKNOWN) { requested = FXNormal; return true; }
+        for (uint32_t n = 1; n <= 3; ++n) {
+            uint32_t p = (s_.lastAcceptedProfile + n) % 3;
+            if (s_.supportedProfiles & (1u << p)) { requested = p; return true; }
+        }
+        return false;
+    }
+    void invalidate() {
+        s_.lastAcceptedProfile = FX_PROFILE_UNKNOWN;
+        s_.lastAcceptedSource = FXNoSource;
+        s_.lastAcceptedUptimeLo = s_.lastAcceptedUptimeHi = 0;
+        fnSeen_ = false;
+        lastFnNS_ = 0;
+    }
+    void suspend() { invalidate(); if (mayProbe()) s_.state = FXSuspended; }
+    void resume() { invalidate(); if (s_.state == FXSuspended) s_.state = FXUnprobed; }
+    // Public IOPM flags: WillChange=1, DidChange=2; CPU|Graphics=3.
+    // Initial priority-interest synchronization has flags=0, from=0.
+    void powerCapabilities(uint32_t flags, uint32_t from, uint32_t to) {
+        if (flags & ~3u) { suspend(); return; }
+        if (flags & 1u) { suspend(); return; }
+        if ((flags & 2u) || (flags == 0 && from == 0)) {
+            if ((to & 3u) == 3u) resume(); else suspend();
+        } else suspend();
+    }
+    void powerUnavailable() {
+        invalidate();
+        if (mayProbe() || s_.state == FXSuspended) s_.state = FXPowerNotifierUnavailable;
+    }
+    void stop() { invalidate(); s_.state = FXStopped; }
+};
+}
+#endif
diff --git a/AsusSMC/FXProfileBridge.hpp b/AsusSMC/FXProfileBridge.hpp
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXProfileBridge.hpp
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef FX_PROFILE_BRIDGE_HPP
+#define FX_PROFILE_BRIDGE_HPP
+// Lilu uses PRIVATE as a visibility attribute; public SDK headers test it
+// as a numeric build flag. Keep that unrelated macro out of SDK includes,
+// then restore it for existing Lilu/VirtualSMC declarations.
+#pragma push_macro("PRIVATE")
+#undef PRIVATE
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/pwr_mgt/RootDomain.h>
+#pragma pop_macro("PRIVATE")
+#include "FXProfilePolicy.hpp"
+#include "FXFnPolicy.hpp"
+class AsusSMC;
+class AsusSMCProfileUserClient;
+struct FXGateCall {
+    enum Operation { Initialize, Query, Set, Message, Suspend, Capabilities, ClaimSession, ReadSession, ReleaseSession, SetClamshell, Stop } operation;
+    uint64_t arrivalNS {0};
+    uint32_t powerFlags {0}, powerFrom {0}, powerTo {0};
+    uint32_t profile {0}, messageType {0};
+    IOService *messageProvider {nullptr};
+    void *messageArgument {nullptr};
+    FXProfileSnapshot *snapshot {nullptr};
+    FXSessionBatch *batch {nullptr};
+    AsusSMCProfileUserClient *client {nullptr};
+    task_t task {TASK_NULL};
+};
+class AsusSMCProfileUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AsusSMCProfileUserClient)
+    IOLock *providerLock_ {nullptr};
+    AsusSMC *asus_ {nullptr};
+    task_t ownerTask_ {TASK_NULL};
+public:
+    bool initWithTask(task_t task, void *securityID, UInt32 type,
+                      OSDictionary *properties) override;
+    bool start(IOService *provider) override;
+    void stop(IOService *provider) override;
+    void free() override;
+    IOReturn clientClose() override;
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *arguments,
+                           IOExternalMethodDispatch *dispatch = nullptr,
+                           OSObject *target = nullptr, void *reference = nullptr) override;
+};
+#endif
diff --git a/AsusSMC/FXProfileBridge.inc b/AsusSMC/FXProfileBridge.inc
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXProfileBridge.inc
@@ -0,0 +1,362 @@
+/* SPDX-License-Identifier: MIT
+ * Included by AsusSMC.cpp so the pinned upstream target builds this code
+ * without silently omitting an unregistered Xcode translation unit.
+ */
+#include <kern/clock.h>
+#include <kern/task.h>
+static_assert(kIOPMSystemCapabilityWillChange == 1 && kIOPMSystemCapabilityDidChange == 2,
+              "Power transition flags changed");
+static_assert(kIOPMSystemCapabilityCPU == 1 && kIOPMSystemCapabilityGraphics == 2,
+              "Power capability mask changed");
+OSDefineMetaClassAndStructors(AsusSMCProfileUserClient, IOUserClient)
+
+bool AsusSMCProfileUserClient::initWithTask(task_t task, void *securityID,
+                                          UInt32 type, OSDictionary *properties) {
+    if (type != FX_PROFILE_CONNECT_TYPE || task == TASK_NULL ||
+        !IOUserClient::initWithTask(task, securityID, type, properties)) return false;
+    providerLock_ = IOLockAlloc();
+    if (!providerLock_) return false;
+    ownerTask_ = task;
+    task_reference(ownerTask_);
+    return true;
+}
+
+bool AsusSMCProfileUserClient::start(IOService *provider) {
+    auto asus = OSDynamicCast(AsusSMC, provider);
+    if (!asus || !IOUserClient::start(provider)) return false;
+    asus->retain();
+    IOLockLock(providerLock_);
+    asus_ = asus;
+    IOLockUnlock(providerLock_);
+    return true;
+}
+
+void AsusSMCProfileUserClient::stop(IOService *provider) {
+    IOLockLock(providerLock_);
+    auto asus = asus_;
+    asus_ = nullptr;
+    IOLockUnlock(providerLock_);
+    if (asus) {
+        FXGateCall call {}; call.operation=FXGateCall::ReleaseSession; call.client=this;
+        (void)asus->fxRun(call);
+        asus->release();
+    }
+    IOUserClient::stop(provider);
+}
+
+void AsusSMCProfileUserClient::free() {
+    if (providerLock_) { IOLockFree(providerLock_); providerLock_ = nullptr; }
+    if (ownerTask_ != TASK_NULL) { task_deallocate(ownerTask_); ownerTask_ = TASK_NULL; }
+    IOUserClient::free();
+}
+
+IOReturn AsusSMCProfileUserClient::clientClose() {
+    terminate();
+    return kIOReturnSuccess;
+}
+
+IOReturn AsusSMCProfileUserClient::externalMethod(uint32_t selector,
+        IOExternalMethodArguments *args, IOExternalMethodDispatch *, OSObject *, void *) {
+    if (!args || isInactive()) return kIOReturnNotAttached;
+    /* No async calls, descriptor-backed structures or arbitrary buffers. */
+    if (args->asyncWakePort != MACH_PORT_NULL || args->asyncReferenceCount != 0 ||
+        args->structureInputSize != 0 || args->structureInputDescriptor ||
+        args->structureOutputDescriptor || args->scalarOutputCount != 0)
+        return kIOReturnBadArgument;
+    FXGateCall call {};
+    if (selector == FXQuery) {
+        if (args->scalarInputCount != 0 || !args->structureOutput ||
+            args->structureOutputSize != sizeof(FXProfileSnapshot)) return kIOReturnBadArgument;
+        call.operation = FXGateCall::Query;
+        call.snapshot = static_cast<FXProfileSnapshot *>(args->structureOutput);
+    } else if (selector == FXSetProfile) {
+        if (args->scalarInputCount != 1 || !args->scalarInput ||
+            args->structureOutputSize != 0 || args->scalarInput[0] > FXSilent)
+            return kIOReturnBadArgument;
+        /* Recheck both owning and invoking task: passing a connection port to
+         * another task cannot confer the opener's write privilege. */
+        if (clientHasPrivilege(ownerTask_, kIOClientPrivilegeAdministrator) != kIOReturnSuccess ||
+            clientHasPrivilege(current_task(), kIOClientPrivilegeAdministrator) != kIOReturnSuccess)
+            return kIOReturnNotPrivileged;
+        call.operation = FXGateCall::Set;
+        call.profile = static_cast<uint32_t>(args->scalarInput[0]);
+    } else if (selector == FXSetClamshell) {
+        if(args->scalarInputCount!=1 || !args->scalarInput || args->scalarInput[0]>1 || args->structureOutputSize) return kIOReturnBadArgument;
+        if(clientHasPrivilege(ownerTask_,kIOClientPrivilegeAdministrator)!=kIOReturnSuccess || clientHasPrivilege(current_task(),kIOClientPrivilegeAdministrator)!=kIOReturnSuccess) return kIOReturnNotPrivileged;
+        call.operation=FXGateCall::SetClamshell; call.profile=static_cast<uint32_t>(args->scalarInput[0]); call.client=this;
+    } else if (selector == FXClaimSession || selector == FXReadSession) {
+        // "console" is the XNU console-user privilege string. Unsupported
+        // implementations fail closed. Never accept a user-supplied UID.
+        if (current_task() != ownerTask_) return kIOReturnNotPrivileged;
+        call.client=this; call.task=ownerTask_;
+        if (selector == FXClaimSession) {
+            if (args->scalarInputCount != 1 || !args->scalarInput ||
+                args->scalarInput[0] > 1 || args->structureOutputSize != 0)
+                return kIOReturnBadArgument;
+            call.operation=args->scalarInput[0] ? FXGateCall::ClaimSession : FXGateCall::ReleaseSession;
+        } else {
+            if (args->scalarInputCount != 0 || !args->structureOutput ||
+                args->structureOutputSize != sizeof(FXSessionBatch)) return kIOReturnBadArgument;
+            call.operation=FXGateCall::ReadSession;
+            call.batch=static_cast<FXSessionBatch *>(args->structureOutput);
+        }
+        // The owner may always relinquish its own claim after switching away.
+        // Acquiring or consuming still requires active-console privilege.
+        if (call.operation != FXGateCall::ReleaseSession &&
+            clientHasPrivilege(ownerTask_, "console") != kIOReturnSuccess)
+            return kIOReturnNotPrivileged;
+    } else return kIOReturnUnsupported;
+    IOLockLock(providerLock_);
+    auto asus = asus_;
+    if (asus) asus->retain();
+    IOLockUnlock(providerLock_);
+    if (!asus) return kIOReturnNotAttached;
+    IOReturn result = asus->fxRun(call);
+    asus->release();
+    return result;
+}
+
+IOReturn AsusSMC::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+                               OSDictionary *properties, IOUserClient **handler) {
+    if (!handler) return kIOReturnBadArgument;
+    *handler = nullptr;
+    if (type != FX_PROFILE_CONNECT_TYPE || isInactive()) return kIOReturnUnsupported;
+    auto client = new AsusSMCProfileUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(owningTask, securityID, type, properties)) {
+        client->release();
+        return kIOReturnNoResources;
+    }
+    if (!client->attach(this)) { client->release(); return kIOReturnNotAttached; }
+    if (!client->start(this)) {
+        client->detach(this);
+        client->release();
+        return kIOReturnNotAttached;
+    }
+    *handler = client;
+    return kIOReturnSuccess;
+}
+
+IOReturn AsusSMC::fxRun(FXGateCall &call) {
+    /* Gate lifetime extends to free(), including after stop(). Each client
+     * retains the service around this synchronous call. Never remove the gate
+     * underneath a queued request. All state below is serialized by it. */
+    if (!command_gate) return kIOReturnNotReady;
+    return command_gate->runAction(fxGateAction, &call);
+}
+
+IOReturn AsusSMC::fxGateAction(OSObject *owner, void *arg0, void *, void *, void *) {
+    auto self = OSDynamicCast(AsusSMC, owner);
+    auto call = static_cast<FXGateCall *>(arg0);
+    if (!self || !call) return kIOReturnBadArgument;
+    if (call->operation == FXGateCall::Stop) {
+        self->fxReleaseSession();
+        if(self->fxLidClient) { if(auto root=self->getPMRootDomain()) root->receivePowerNotification(kIOPMEnableClamshell); self->fxLidClient=nullptr; self->setProperty("FX505GTLidSleepDisabled",false); }
+        self->fxFullyAwake=false;
+        self->fxRunning = false;
+        self->fxPolicy.stop();
+        return kIOReturnSuccess;
+    }
+    if (call->operation == FXGateCall::ReleaseSession) {
+        if (self->fxSessionClient == call->client) self->fxReleaseSession();
+        if(self->fxLidClient==call->client) { if(auto root=self->getPMRootDomain()) root->receivePowerNotification(kIOPMEnableClamshell); self->fxLidClient=nullptr; self->setProperty("FX505GTLidSleepDisabled",false); }
+        return kIOReturnSuccess;
+    }
+    if (call->operation == FXGateCall::Initialize) {
+        auto enabled = OSDynamicCast(OSBoolean, self->getProperty("FX505GTProfileBridgeEnabled"));
+        auto model = OSDynamicCast(OSString, self->getProperty("FX505GTProfileModel"));
+        auto fn = OSDynamicCast(OSBoolean, self->getProperty("FX505GTProfileFnF5Enabled"));
+        self->fxPolicy.configure(enabled && enabled->isTrue(),
+            model && model->isEqualTo("FX505GT"), self->fxWmiVerified,
+            fn && fn->isTrue());
+        auto routes = OSDynamicCast(OSBoolean, self->getProperty("FX505GTDedicatedFnContractEnabled"));
+        self->fxFnQueue.configure(routes && routes->isTrue() && model &&
+            model->isEqualTo("FX505GT") && self->fxWmiVerified);
+        self->fxFullyAwake=false;
+        self->fxRunning = true;
+        self->fxPolicy.suspend(); // No I/O until initial full-wake capability synchronization.
+        self->fxPowerNotifier = registerPrioritySleepWakeInterest(fxPowerInterest, self);
+        if (!self->fxPowerNotifier) self->fxPolicy.powerUnavailable();
+        self->fxRefresh();
+        return kIOReturnSuccess;
+    }
+    if (!self->fxRunning || self->isInactive() || !self->atkDevice ||
+        self->atkDevice != self->getProvider()) return kIOReturnNotAttached;
+    if(call->operation==FXGateCall::SetClamshell) {
+        auto root=self->getPMRootDomain(); if(!root) return kIOReturnNotReady;
+        if(call->profile) {
+            if(self->fxLidClient && self->fxLidClient!=call->client) return kIOReturnExclusiveAccess;
+            IOReturn result=root->receivePowerNotification(kIOPMDisableClamshell);
+            if(result==kIOReturnSuccess) { self->fxLidClient=call->client; self->setProperty("FX505GTLidSleepDisabled",true); }
+            return result;
+        }
+        if(self->fxLidClient!=call->client) return kIOReturnSuccess;
+        IOReturn result=root->receivePowerNotification(kIOPMEnableClamshell);
+        if(result==kIOReturnSuccess) { self->fxLidClient=nullptr; self->setProperty("FX505GTLidSleepDisabled",false); }
+        return result;
+    }
+    if (call->operation == FXGateCall::Suspend) {
+        self->fxPolicy.suspend();
+        self->fxFullyAwake=false; self->fxReleaseSession();
+        return kIOReturnSuccess;
+    }
+    if (call->operation == FXGateCall::Capabilities) {
+        self->fxPolicy.powerCapabilities(call->powerFlags, call->powerFrom, call->powerTo);
+        self->fxFullyAwake=!(call->powerFlags & ~3u) && !(call->powerFlags & 1u) &&
+            ((call->powerFlags & 2u) || (!call->powerFlags && !call->powerFrom)) &&
+            (call->powerTo & 3u)==3u;
+        if (!self->fxFullyAwake) self->fxReleaseSession();
+        else if(self->fxLidClient) { if(auto root=self->getPMRootDomain()) root->receivePowerNotification(kIOPMDisableClamshell); }
+        return kIOReturnSuccess;
+    }
+    if (call->operation == FXGateCall::Message) {
+        if (self->fxPolicy.snapshot().state == FXSuspended) return kIOReturnNotReady;
+        return self->fxMessage(call->messageType, call->messageProvider,
+                               call->messageArgument, call->arrivalNS);
+    }
+    if (call->operation == FXGateCall::ClaimSession || call->operation == FXGateCall::ReadSession) {
+        if (!self->fxFnQueue.enabled() || !self->fxFullyAwake) return kIOReturnNotReady;
+        if (!call->task || IOUserClient::clientHasPrivilege(call->task,"console") != kIOReturnSuccess) return kIOReturnNotPrivileged;
+        uint64_t now=fxTimestamp();
+        if (self->fxSessionClient && (now < self->fxSessionPollNS || now-self->fxSessionPollNS>2000000000ull ||
+            IOUserClient::clientHasPrivilege(self->fxSessionTask, "console") != kIOReturnSuccess))
+            self->fxReleaseSession();
+        if (call->operation == FXGateCall::ClaimSession) {
+            if (self->fxSessionClient && self->fxSessionClient != call->client) return kIOReturnExclusiveAccess;
+            if (!self->fxSessionClient) {
+                self->fxSessionClient=call->client; self->fxSessionTask=call->task;
+                task_reference(self->fxSessionTask);
+            }
+            self->fxFnQueue.clear(); // Explicit re-claim never replays an old batch.
+        } else {
+            if (self->fxSessionClient != call->client || !call->batch) return kIOReturnNotOpen;
+            *call->batch=self->fxFnQueue.drain(now);
+        }
+        self->fxSessionPollNS=now;
+        return kIOReturnSuccess;
+    }
+    self->fxRefresh();
+    if (call->operation == FXGateCall::Query) {
+        if (!call->snapshot) return kIOReturnBadArgument;
+        *call->snapshot = self->fxPolicy.snapshot();
+        return kIOReturnSuccess;
+    }
+    if (call->operation == FXGateCall::Set)
+        return self->fxSet(call->profile, FXCommandLine);
+    return kIOReturnUnsupported;
+}
+
+fx::Raw AsusSMC::fxEvaluate(uint32_t method, uint32_t device, uint32_t value) {
+    /* Only private callers select these two method IDs and two fixed devices.
+     * A guessed WMNB fallback is never accepted for this bridge. */
+    if (!fxWmiVerified || !atkDevice || atkDevice != getProvider() ||
+        (method != ASUS_WMI_METHODID_DSTS && method != ASUS_WMI_METHODID_DEVS) ||
+        (device != fx::ThermalDevice && device != fx::FanBoostDevice))
+        return fx::Raw::decode(false, 0, kIOReturnUnsupported);
+    wmi_args input {device, value};
+    OSObject *args[3] = {OSNumber::withNumber(0ULL, 32),
+        OSNumber::withNumber(method, 32), OSData::withBytes(&input, sizeof(input))};
+    if (!args[0] || !args[1] || !args[2]) {
+        for (unsigned i = 0; i < 3; ++i) if (args[i]) args[i]->release();
+        return fx::Raw::decode(false, 0, kIOReturnNoMemory);
+    }
+    uint32_t raw = 0;
+    IOReturn ret = atkDevice->evaluateInteger(wmi_method, &raw, args, 3);
+    for (unsigned i = 0; i < 3; ++i) args[i]->release();
+    return fx::Raw::decode(ret == kIOReturnSuccess, raw, ret);
+}
+
+void AsusSMC::fxRefresh() {
+    if (!fxPolicy.mayProbe()) return;
+    auto thermal = fxEvaluate(ASUS_WMI_METHODID_DSTS, fx::ThermalDevice, 0);
+    auto fan = fxEvaluate(ASUS_WMI_METHODID_DSTS, fx::FanBoostDevice, 0);
+    fxPolicy.probe(thermal, fan);
+}
+
+IOReturn AsusSMC::fxSet(uint32_t profile, uint32_t source) {
+    if (!fxPolicy.prepare(profile, source, fxTimestamp())) return kIOReturnUnsupported;
+    auto result = fxEvaluate(ASUS_WMI_METHODID_DEVS, fxPolicy.device(), profile);
+    return fxPolicy.complete(result, fxTimestamp()) ? kIOReturnSuccess : kIOReturnIOError;
+}
+
+void AsusSMC::fxHandleFn(uint32_t code, uint64_t arrivalNS) {
+    if (code != 0x99u && code != 0xaeu) return;
+    fxRefresh();
+    uint32_t requested = FX_PROFILE_UNKNOWN;
+    if (fxPolicy.fnEvent(code, arrivalNS, requested))
+        (void)fxSet(requested, FXFnF5);
+}
+
+uint64_t AsusSMC::fxTimestamp() {
+    uint64_t uptime = 0, nanoseconds = 0;
+    clock_get_uptime(&uptime);
+    absolutetime_to_nanoseconds(uptime, &nanoseconds);
+    return nanoseconds;
+}
+
+IOReturn AsusSMC::fxPowerInterest(void *target, void *, UInt32 type,
+                                  IOService *, void *argument, vm_size_t size) {
+    auto self = static_cast<AsusSMC *>(target);
+    if (!self) return kIOReturnBadArgument;
+    FXGateCall call {};
+    switch (type) {
+        case kIOMessageSystemWillSleep:
+            call.operation = FXGateCall::Suspend;
+            (void)self->fxRun(call); // Serialize with any in-flight request.
+            // Priority-interest callbacks receive a notification structure,
+            // not an acknowledgement cookie. Synchronous completion leaves
+            // its initialized returnValue=0: no asynchronous ack is needed.
+            return kIOReturnSuccess;
+        case kIOMessageSystemCapabilityChange: {
+            if (!argument || size < sizeof(IOPMSystemCapabilityChangeParameters)) {
+                call.operation = FXGateCall::Suspend;
+            } else {
+                auto change = static_cast<const IOPMSystemCapabilityChangeParameters *>(argument);
+                call.operation = FXGateCall::Capabilities;
+                call.powerFlags = change->changeFlags;
+                call.powerFrom = change->fromCapabilities;
+                call.powerTo = change->toCapabilities;
+            }
+            (void)self->fxRun(call);
+            return kIOReturnSuccess; // Synchronous; maxWaitForReply remains zero.
+        }
+        case kIOMessageSystemHasPoweredOn:
+        case kIOMessageSystemWillNotSleep:
+            // Capability synchronization, not this legacy message, permits I/O.
+            return kIOReturnSuccess;
+        case kIOMessageCanSystemSleep:
+            return kIOReturnSuccess;
+        default: return kIOReturnSuccess;
+    }
+}
+
+void AsusSMC::fxReleaseSession() {
+    fxSessionClient=nullptr;
+    if (fxSessionTask != TASK_NULL) { task_deallocate(fxSessionTask); fxSessionTask=TASK_NULL; }
+    fxSessionPollNS=0; fxFnQueue.clear();
+}
+
+bool AsusSMC::fxRouteFn(uint32_t code, uint64_t now) {
+    if (!fxFnQueue.enabled()) return false;
+    // In the dedicated contract, conflicting legacy synthetic/raw meanings
+    // are deliberately suppressed, never reinterpreted as power actions.
+    if (code==0x33 || code==0x34 || code==0x35 || code==0x5e || code==0x7d) return true;
+    auto route=fx::fnRoute(code);
+    if (!route.recognized) return false;
+    if (!fxFullyAwake) return true;
+    if (route.hidCode) handleMessage(route.hidCode); // Exactly one stock HID action.
+    else if (route.fan) {
+        fxRefresh();
+        auto backend=fxPolicy.snapshot().backend;
+        if (backend==FXThermalPolicy) fxHandleFn(0xae,now);
+        else if (backend==FXFanBoost) fxHandleFn(0x99,now);
+    } else if (route.action) {
+        const uint64_t leaseNow=fxTimestamp(); // Arrival can predate a newer gated poll.
+        if (!fxSessionClient || leaseNow<fxSessionPollNS || leaseNow-fxSessionPollNS>2000000000ull ||
+            IOUserClient::clientHasPrivilege(fxSessionTask,"console") != kIOReturnSuccess) {
+            fxReleaseSession(); return true; // No consumer: no deferred replay.
+        }
+        fxFnQueue.push(route.action,code,now);
+    }
+    return true;
+}
diff --git a/AsusSMC/FXFnABI.h b/AsusSMC/FXFnABI.h
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXFnABI.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT
+ * Dedicated opt-in ACPI contract, NOT claimed native FX505GT event numbers.
+ * FXFnBase + 1..12 = F1..F12; +13/+14 = Up/Down.
+ */
+#ifndef FX_FN_ABI_H
+#define FX_FN_ABI_H
+#include <stdint.h>
+#define FX_FN_ABI_VERSION 3u
+#define FX_FN_EVENT_BASE 0x0000f500u
+#define FX_FN_CAPACITY 16u
+enum FXFnSelector { FXClaimSession = 2, FXReadSession = 3 };
+enum FXSessionAction { FXNoAction = 0, FXMicrophoneMute = 1,
+    FXPanelPowerToggle = 2, FXSystemSleep = 3, FXRadiosToggle = 4,
+    FXBrightnessDown = 5, FXBrightnessUp = 6 };
+typedef struct FXSessionEvent {
+    uint32_t action, acpiCode, uptimeLo, uptimeHi;
+} FXSessionEvent;
+typedef struct FXSessionBatch {
+    uint32_t version, size, enabled, count;
+    uint32_t dropped, lastObservedCode, observedCount, reserved;
+    FXSessionEvent events[FX_FN_CAPACITY];
+} FXSessionBatch;
+#ifdef __cplusplus
+static_assert(sizeof(FXSessionBatch) == 288, "Fn ABI changed");
+#endif
+#endif
diff --git a/AsusSMC/FXFnPolicy.hpp b/AsusSMC/FXFnPolicy.hpp
new file mode 100644
--- /dev/null
+++ b/AsusSMC/FXFnPolicy.hpp
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: MIT. Pure bounded routing/queue logic, no device I/O. */
+#ifndef FX_FN_POLICY_HPP
+#define FX_FN_POLICY_HPP
+#include "FXFnABI.h"
+namespace fx {
+struct FnRoute {
+    uint32_t hidCode, action;
+    bool fan, recognized;
+};
+inline FnRoute fnRoute(uint32_t code) {
+    switch (code) {
+        case FX_FN_EVENT_BASE+1: return {0x32, 0, false, true};
+        case FX_FN_EVENT_BASE+2: return {0x31, 0, false, true};
+        case FX_FN_EVENT_BASE+3: return {0x30, 0, false, true};
+        case FX_FN_EVENT_BASE+4: return {0, FXMicrophoneMute, false, true};
+        case FX_FN_EVENT_BASE+5: return {0, 0, true, true};
+        case FX_FN_EVENT_BASE+6: return {0, FXPanelPowerToggle, false, true};
+        case FX_FN_EVENT_BASE+7: return {0, FXBrightnessDown, false, true};
+        case FX_FN_EVENT_BASE+8: return {0, FXBrightnessUp, false, true};
+        case FX_FN_EVENT_BASE+9: return {0x61, 0, false, true};
+        case FX_FN_EVENT_BASE+10: return {0x6b, 0, false, true};
+        case FX_FN_EVENT_BASE+11: return {0, FXSystemSleep, false, true};
+        case FX_FN_EVENT_BASE+12: return {0, FXRadiosToggle, false, true};
+        case FX_FN_EVENT_BASE+13: return {0xc4, 0, false, true};
+        case FX_FN_EVENT_BASE+14: return {0xc5, 0, false, true};
+        default: return {0, 0, false, false};
+    }
+}
+class FnQueue {
+    FXSessionBatch batch_ {};
+    uint64_t lastNS_[FXBrightnessUp+1] {};
+    bool seen_[FXBrightnessUp+1] {};
+public:
+    FnQueue() { batch_.version=FX_FN_ABI_VERSION; batch_.size=sizeof(batch_); }
+    void configure(bool enabled) { batch_.enabled=enabled; clear(); }
+    bool enabled() const { return batch_.enabled != 0; }
+    void observe(uint32_t code) { batch_.lastObservedCode=code; ++batch_.observedCount; }
+    void clear() { batch_.count=0; for (unsigned i=0;i<=FXBrightnessUp;++i) { lastNS_[i]=0; seen_[i]=false; } }
+    void push(uint32_t action, uint32_t code, uint64_t now) {
+        if (!enabled() || action<FXMicrophoneMute || action>FXBrightnessUp) return;
+        if (action<FXBrightnessDown && seen_[action] && now>=lastNS_[action] && now-lastNS_[action]<250000000ull) return;
+        lastNS_[action]=now; seen_[action]=true;
+        if (batch_.count==FX_FN_CAPACITY) { ++batch_.dropped; return; }
+        batch_.events[batch_.count++]={action,code,static_cast<uint32_t>(now),static_cast<uint32_t>(now>>32)};
+    }
+    FXSessionBatch drain(uint64_t now) {
+        FXSessionBatch out=batch_; out.count=0;
+        for (uint32_t i=0;i<batch_.count;++i) {
+            auto e=batch_.events[i]; uint64_t t=(static_cast<uint64_t>(e.uptimeHi)<<32)|e.uptimeLo;
+            if (now>=t && now-t<=2000000000ull) out.events[out.count++]=e;
+            else ++batch_.dropped;
+        }
+        out.dropped=batch_.dropped;
+        // No stale memory, and never return a consumed event twice.
+        for (uint32_t i=out.count;i<FX_FN_CAPACITY;++i) out.events[i]={0,0,0,0};
+        batch_.count=0;
+        return out;
+    }
+};
+}
+#endif
